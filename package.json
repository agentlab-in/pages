{
  "name": "@agentlab/pages",
  "version": "2.0.0",
  "description": "Scratch web host CLI: publish tiny HTML apps to Cloudflare Pages",
  "type": "module",
  "bin": {
    "agentlab-pages": "./dist/cli.js",
    "alab": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "alab": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
